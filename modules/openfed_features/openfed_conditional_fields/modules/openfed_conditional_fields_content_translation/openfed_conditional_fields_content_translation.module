use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\openfed_conditional_fields_content_translation\Hook\OpenfedConditionalFieldsContentTranslationHooks;

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function openfed_conditional_fields_content_translation_entity_type_alter(array &$entity_types): void {
  \Drupal::service(OpenfedConditionalFieldsContentTranslationHooks::class)->entityTypeAlter($entity_types);
}
