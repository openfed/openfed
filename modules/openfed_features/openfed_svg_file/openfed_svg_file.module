<?php

/**
 * @file
 * Contains openfed_svg_file.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\openfed_svg_file\Hook\OpenfedSvgFileHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function openfed_svg_file_help($route_name, RouteMatchInterface $route_match): string {
  return \Drupal::service(OpenfedSvgFileHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function openfed_svg_file_theme(): array {
    return \Drupal::service(OpenfedSvgFileHooks::class)->theme();
}

/**
  * Pre-defined SVG output types.
  */
function get_output_types(): array {
  return [
    'image' => t('Image'),
    'embed' => t('Embed'),
    'object' => t('Object'),
    'iframe' => t('Iframe'),
    'inline' => t('Inline'),
  ];
}
