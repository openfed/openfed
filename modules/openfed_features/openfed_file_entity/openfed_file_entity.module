<?php

/**
 * @file
 * Contains openfed_file_entity.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\openfed_file_entity\Hook\OpenfedFileEntityHooks;

/**
 * Implements hook_modules_installed().
 */
#[LegacyHook]
function openfed_file_entity_modules_installed($modules, $is_syncing): void {
  \Drupal::service(OpenfedFileEntityHooks::class)->modulesInstalled($modules, $is_syncing);
}
