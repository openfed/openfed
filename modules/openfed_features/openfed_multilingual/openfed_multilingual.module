<?php

/**
 * @file
 * Contains openfed_multilingual.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\openfed_multilingual\Hook\OpenfedMultilingualHooks;
use Drupal\Core\Url;

/**
 * Implements hook_language_switch_links_alter();
 *
 * This will override language switch block links, removing the link and
 * setting a "disabled" class on non-translated content.
 */
#[LegacyHook]
function openfed_multilingual_language_switch_links_alter(array &$links, $type, $path): void {
  \Drupal::service(OpenfedMultilingualHooks::class)->languageSwitchLinksAlter($links, $type, $path);
}
