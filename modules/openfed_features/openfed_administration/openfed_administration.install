<?php
/**
 * @file
 * Contains install and update functions for Openfed Administration.
 */

use Drupal\openfed_administration\Plugin\views\field\EntityTranslations;

/**
 * Implements hook_install().
 */
function openfed_administration_install() {
  // Discover all the module configurations that we'll use to override existing
  // ones.
  $module = basename(__FILE__, '.install');
  $module_configs = \Drupal::configFactory()->listAll($module);

  // Overriding existing configurations.
  if (!empty($module_configs)) {
    foreach ($module_configs as $module_config_name) {
      $config = \Drupal::configFactory()->getEditable($module_config_name);
      // All the configurations set in this module starting with the module name
      // are overrides of the an already existing config. Here we'll get the
      // exiting config name.
      $existing_config = str_replace($module . '.', '', $module_config_name);
      $existing_config = \Drupal::configFactory()->getEditable($existing_config);
      // Keep the uuid of the existing config (or create one), the override
      // files don't have one.
      $data = $config->get();
      $data['uuid'] = $existing_config->get('uuid') ?: \Drupal::service('uuid')->generate();
      $existing_config->setData($data)->save();
      // We don't need to keep this config.
      $config->delete();
    }
  }
}

/**
 * Rename "Embeddable" labels to "Media" in the media view config.
 */
function openfed_administration_update_10001() {
  $config = \Drupal::configFactory()->getEditable('views.view.media');
  $data = $config->getRawData();

  if (empty($data)) {
    return 'Config views.view.media not found, nothing to update.';
  }

  $changed = FALSE;

  // Recursively replace exact string matches.
  $replace_embeddable = function (&$value) use (&$replace_embeddable, &$changed) {
    if (is_array($value)) {
      foreach ($value as &$item) {
        $replace_embeddable($item);
      }
      return;
    }

    if ($value === 'Embeddable') {
      $value = 'Media';
      $changed = TRUE;
    }
  };

  $replace_embeddable($data);

  if ($changed) {
    // Normalize legacy language exclusions before resaving the Media view.
    _openfed_administration_normalize_view_entity_languages($data);
    $config->setData($data)->save();
    return 'Updated views.view.media labels from "Embeddable" to "Media".';
  }

  return 'No "Embeddable" labels found in views.view.media.';
}

/**
 * Store Views translation exclusions as lists of language codes.
 */
function openfed_administration_update_10002(): void {
  // Numbered updates run before Views post-updates that resave the views.
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('views.view.') as $name) {
    $config = $config_factory->getEditable($name);
    $data = $config->getRawData();
    if (_openfed_administration_normalize_view_entity_languages($data)) {
      $config->setData($data)->save();
    }
  }
}

/**
 * Normalizes translation exclusions in a view's stored field definitions.
 */
function _openfed_administration_normalize_view_entity_languages(array &$data): bool {
  $changed = FALSE;
  foreach ($data['display'] ?? [] as $display_id => $display) {
    foreach ($display['display_options']['fields'] ?? [] as $field_id => $field) {
      if (($field['plugin_id'] ?? NULL) !== 'entity_translations' || !array_key_exists('entity_languages', $field)) {
        continue;
      }
      $languages = EntityTranslations::normalizeExcludedLanguages($field['entity_languages']);
      if ($languages !== $field['entity_languages']) {
        $data['display'][$display_id]['display_options']['fields'][$field_id]['entity_languages'] = $languages;
        $changed = TRUE;
      }
    }
  }
  return $changed;
}
