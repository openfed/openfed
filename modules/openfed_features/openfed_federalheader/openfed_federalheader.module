<?php

/**
 * @file
 * Contains openfed_federalheader.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\openfed_federalheader\Hook\OpenfedFederalheaderHooks;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function openfed_federalheader_theme($existing, $type, $theme, $path): array {
  return \Drupal::service(OpenfedFederalheaderHooks::class)->theme($existing, $type, $theme, $path);
}
