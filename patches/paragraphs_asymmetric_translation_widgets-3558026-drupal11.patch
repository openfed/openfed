@@ -0,0 +1,34 @@
+<?php
+
+/**
+ * @file
+ * Install, update and uninstall functions for paragraphs_asymmetric_translation_widgets.
+ */
+
+/**
+ * Helper function to set the module weight to paragraphs weight + 1 from key_value table.
+ */
+function _paragraphs_asymmetric_translation_widgets_set_weight_relative() {
+  // Get the weight of the paragraphs module from core.extension config.
+  $extension_config = \Drupal::configFactory()->get('core.extension');
+  $editor_module_weight = $extension_config->get('module.paragraphs');
+  // Set the weight of paragraphs_asymmetric_translation_widgets to paragraphs weight + 1.
+  module_set_weight('paragraphs_asymmetric_translation_widgets', $editor_module_weight + 1);
+}
+
+/**
+ * Implements hook_install().
+ *
+ * Sets the module weight to paragraphs weight + 1 on install.
+ */
+function paragraphs_asymmetric_translation_widgets_install() {
+  _paragraphs_asymmetric_translation_widgets_set_weight_relative();
+}
+
+/**
+ * Update hook to ensure module weight is set to paragraphs weight + 1.
+ */
+function paragraphs_asymmetric_translation_widgets_update_8101() {
+  _paragraphs_asymmetric_translation_widgets_set_weight_relative();
+  return t('Module weight for paragraphs_asymmetric_translation_widgets set to paragraphs weight + 1.');
+}
