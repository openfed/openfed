--- a/link_attributes.module
+++ b/link_attributes.module
@@ -5,10 +5,34 @@
  * Contains main module functions.
  */
 
+use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
+use Drupal\Core\Field\Entity\BaseFieldOverride;
 use Drupal\Core\Hook\Attribute\LegacyHook;
 use Drupal\link_attributes\Hook\LinkAttributesHooks;
 use Drupal\Core\Routing\RouteMatchInterface;
 
+/**
+ * Expose the selected link attributes on menu link content form.
+ *
+ * Implements hook_entity_form_display_alter().
+ */
+function link_attributes_entity_form_display_alter(EntityFormDisplayInterface $form_display, array $context) {
+  $entity_type = $context['entity_type'];
+  $bundle = $context['bundle'];
+  if ($entity_type == 'menu_link_content' && $context['form_mode'] == 'default') {
+    // Load the fieldDefinition and check the
+    // third_party_settings.link_attributes.enabled_attributes to see which
+    // fields to display.
+    $fieldDefinition = \Drupal::service('entity_field.manager')->getFieldDefinitions($entity_type, $bundle)['link'];
+    if ($fieldDefinition instanceof BaseFieldOverride) {
+      $enabled_attributes = $fieldDefinition->getThirdPartySetting('link_attributes', 'enabled_attributes') ?? [];
+      $link = $form_display->getComponent('link');
+      $link['settings']['enabled_attributes'] = array_merge($link['settings']['enabled_attributes'], $enabled_attributes);
+      $form_display->setComponent('link', $link);
+    }
+  }
+}
