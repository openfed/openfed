+<?php
+
+namespace Drupal\link_attributes\Form;
+
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Config\TypedConfigManagerInterface;
+use Drupal\Core\Entity\EntityFieldManagerInterface;
+use Drupal\Core\Field\Entity\BaseFieldOverride;
+use Drupal\Core\Form\ConfigFormBase;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\link_attributes\LinkAttributesManager;
+use Drupal\link_attributes\Plugin\Field\FieldWidget\LinkWithAttributesWidget;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Settings form.
+ */
+class LinkAttributesSettingsForm extends ConfigFormBase {
+
+  /**
+   * The LinkAttributesManager.
+   *
+   * @var \Drupal\link_attributes\LinkAttributesManager
+   */
+  protected $linkAttributesManager;
+  /**
+   * The EntityFieldManager.
+   *
+   * @var \Drupal\Core\Entity\EntityFieldManagerInterface
+   */
+  protected $entityFieldManager;
+  /**
+   * The menu_link_content fieldDefinition.
+   *
+   * @var \Drupal\Core\Field\FieldDefinitionInterface
+   */
+  protected $linkFieldDefinition;
+
+  /**
+   * Constructor.
+   *
+   * @param \Drupal\Core\Config\ConfigFactoryInterface $config_factory
+   *   The factory for configuration objects.
+   * @param \Drupal\link_attributes\LinkAttributesManager $link_attributes_manager
+   *   The link attributes manager.
+   * @param \Drupal\Core\Entity\EntityFieldManagerInterface $entityFieldManager
+   *   The entity field manager.
+   * @param \Drupal\Core\Config\TypedConfigManagerInterface $typed_config_manager
+   *   The typed configuration manager.
+   */
+  public function __construct(ConfigFactoryInterface $config_factory, LinkAttributesManager $link_attributes_manager, EntityFieldManagerInterface $entityFieldManager, TypedConfigManagerInterface $typed_config_manager) {
+    parent::__construct($config_factory, $typed_config_manager);
+    $this->linkAttributesManager = $link_attributes_manager;
+    $this->entityFieldManager = $entityFieldManager;
+
+    $baseFieldDefinitions = $this->entityFieldManager->getFieldDefinitions('menu_link_content', 'menu_link_content');
+    $this->linkFieldDefinition = $baseFieldDefinitions['link'];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container) {
+    return new static(
+      $container->get('config.factory'),
+      $container->get('plugin.manager.link_attributes'),
+      $container->get('entity_field.manager'),
+      $container->get('config.typed')
+    );
+  }
+
+  /**
+   * Gets the configuration names that will be editable.
+   *
+   * @return array
+   *   An array of configuration object names that are editable if called in
+   *   conjunction with the trait's config() method.
+   */
+  protected function getEditableConfigNames() {
+    return [];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId() {
+    return 'link_attributes_settings_form';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildForm(array $form, FormStateInterface $form_state) {
+    // Build the array of available link attributes.
+    $options = [];
+    $plugin_definitions = $this->linkAttributesManager->getDefinitions();
+    array_walk($plugin_definitions, function ($definition, $key) use (&$options) {
+      $options[$key] = $definition['title'];
+    });
+    ksort($options);
+
+    // Build an array of the enabled attributes from the field
+    // third_party_settings.link_attributes.enabled_attributes.
+    $enabled_attributes = [];
+    if ($this->linkFieldDefinition instanceof BaseFieldOverride) {
+      $enabled_attributes = $this->linkFieldDefinition->getThirdPartySetting('link_attributes', 'enabled_attributes') ?? [];
+    }
+    $enabledAttrs = [];
+    array_walk($enabled_attributes, function ($enabled, $attr) use (&$enabledAttrs) {
+      $enabledAttrs[$attr] = $enabled ? $attr : 0;
+    });
+
+    // Build the array of default attributes from the widget.
+    $widgetDefaultAttrs = [];
+    array_walk(LinkWithAttributesWidget::defaultSettings()['enabled_attributes'], function ($enabled, $attr) use (&$widgetDefaultAttrs) {
+      $widgetDefaultAttrs[$attr] = $enabled ? $attr : 0;
+    });
+
+    $form['enabled_attributes'] = [
+      '#type' => 'checkboxes',
+      '#title' => $this->t('Enabled Menu Link Attributes'),
+      '#options' => $options,
+      '#default_value' => $enabledAttrs ?: $widgetDefaultAttrs,
+    ];
+
+    return parent::buildForm($form, $form_state);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state) {
+    $enabled_attributes = $form_state->getValue('enabled_attributes');
+    $enabled_attributes = array_map(function ($value) {
+      return $value !== 0 ? TRUE : FALSE;
+    }, $enabled_attributes);
+
+    $linkFieldOverride = BaseFieldOverride::loadByName('menu_link_content', 'menu_link_content', 'link');
+    if (!$linkFieldOverride) {
+      $linkFieldOverride = BaseFieldOverride::createFromBaseFieldDefinition($this->linkFieldDefinition, 'menu_link_content');
+    }
+
+    $linkFieldOverride->setThirdPartySetting('link_attributes', 'enabled_attributes', $enabled_attributes);
+    $linkFieldOverride->save();
+
+    $this->messenger()->addStatus($this->t('The menu link settings have been saved.'));
+  }
+
+}
